# =====================================================================
# ScholarForge OS - Environment Configuration Template
# Copy this file to .env and fill in your API credentials.
# The .env file is gitignored and will never be committed to repository.
# =====================================================================

# ---------------------------------------------------------------------
# Primary LLM Engine (Google Gemini 3.8 / 2.5)
# Obtain free or pay-as-you-go key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Server & Runtime Configuration
# ---------------------------------------------------------------------
PORT=8008
HOST=127.0.0.1
DEFAULT_WORKHORSE=gemini-3.8-flash
FLASH_THINKING_BUDGET=high
ENABLE_GOOGLE_SEARCH_GROUNDING=true

# ---------------------------------------------------------------------
# Optional Academic & Commercial API Vault (BYOK)
# All core search and download features work 100% free without these.
# Add keys below only if you have active subscriptions or tokens.
# ---------------------------------------------------------------------
NCBI_API_KEY=               # Increases PubMed request rate from 3 to 10 req/s
CORE_API_KEY=               # Access to CORE UK scholarly index
SERPAPI_KEY=                # Google Scholar direct scraping fallback
SCITE_API_KEY=              # Smart citation classification (supporting/contrasting)
GROQ_API_KEY=               # Ultra-fast open-weights inference (Llama 3.3)
OPENROUTER_API_KEY=         # Multi-model gateway
CEREBRAS_API_KEY=           # High-speed Llama inference
DEEPL_API_KEY=              # Academic translation
ZENODO_TOKEN=               # Ingestion of open science datasets
MATERIALS_PROJECT_KEY=      # Inorganic crystal materials database
OPENAI_API_KEY=             # Optional OpenAI API fallback
